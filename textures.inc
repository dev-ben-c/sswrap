/* ------------------------------------------------------------------ texture dump / replace
 * Every level-0 glTexImage2D upload is fingerprinted (FNV-1a over the pixels, plus size and
 * format). With TextureDump=1 each new texture is written to sswrap_textures\dump\ as a TGA.
 * If sswrap_textures\load\ has a PNG/TGA/JPG with the same name, it is uploaded instead
 * (any size, e.g. a 4x AI upscale), with mipmaps generated by the driver; the game's own
 * mip levels and sub-image updates for that texture are then skipped.
 * File names: <width>x<height>_<16 hex digits>.<ext>, the size being the ORIGINAL size. */

#define STB_IMAGE_IMPLEMENTATION
#define STBI_ONLY_PNG
#define STBI_ONLY_TGA
#define STBI_ONLY_JPEG
#define STBI_NO_STDIO_WARNINGS
#include "third_party/stb_image.h"

#define GL_UNPACK_ROW_LENGTH_   0x0CF2
#define GL_UNPACK_ALIGNMENT_    0x0CF5
#define GL_GENERATE_MIPMAP_     0x8191
#define GL_BGRA_                0x80E1
#define GL_BGR_                 0x80E0

typedef void (WINAPI *PFN_glTexSubImage2D)(GLenum, GLint, GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, const GLvoid *);

static char g_tex_dir[MAX_PATH];           /* ...\sswrap_textures */
static struct { char name[48]; } *g_load_names; static int g_nload;   /* replacements on disk */
static unsigned long long *g_dumped; static int g_ndumped, g_cap_dumped;
static GLuint g_replaced[4096]; static int g_nreplaced;               /* texture ids we replaced */
static LONG st_uploads, st_dumped, st_replaced, st_unsupported;

/* bytes per pixel for the formats we understand (unsigned byte only); 0 = unsupported */
static int tex_bpp(GLenum fmt, GLenum type)
{
    if (type != GL_UNSIGNED_BYTE) return 0;
    switch (fmt) {
    case GL_RGBA: case GL_BGRA_: return 4;
    case GL_RGB: case GL_BGR_: return 3;
    case GL_LUMINANCE_ALPHA: return 2;
    case GL_LUMINANCE: case GL_ALPHA: case GL_INTENSITY: case GL_RED: return 1;
    default: return 0;
    }
}

static const char *fmt_name(GLenum f)
{
    switch (f) {
    case GL_RGBA: return "RGBA"; case GL_RGB: return "RGB"; case GL_BGRA_: return "BGRA"; case GL_BGR_: return "BGR";
    case GL_LUMINANCE: return "LUM"; case GL_LUMINANCE_ALPHA: return "LUMA"; case GL_ALPHA: return "ALPHA";
    case GL_COLOR_INDEX: return "COLOR_INDEX"; default: return "?";
    }
}

static int row_stride(int w, int bpp)
{
    GLint align = 4, rowlen = 0;
    REAL(glGetIntegerv)(GL_UNPACK_ALIGNMENT_, &align);
    REAL(glGetIntegerv)(GL_UNPACK_ROW_LENGTH_, &rowlen);
    int px = rowlen > 0 ? rowlen : w;
    int s = px * bpp;
    if (align > 1) s = (s + align - 1) / align * align;
    return s;
}

static unsigned long long tex_hash(const unsigned char *p, int w, int h, int bpp, int stride, GLenum fmt)
{
    unsigned long long x = 1469598103934665603ULL;
    x = (x ^ (unsigned)w) * 1099511628211ULL; x = (x ^ (unsigned)h) * 1099511628211ULL; x = (x ^ fmt) * 1099511628211ULL;
    for (int y = 0; y < h; y++) {
        const unsigned char *r = p + (size_t)y * stride;
        for (int i = 0; i < w * bpp; i++) x = (x ^ r[i]) * 1099511628211ULL;
    }
    return x;
}

/* tightly packed RGBA8 copy of the upload (caller frees) */
static unsigned char *to_rgba(const unsigned char *p, int w, int h, int stride, GLenum fmt)
{
    unsigned char *o = malloc((size_t)w * h * 4);
    if (!o) return NULL;
    for (int y = 0; y < h; y++) {
        const unsigned char *s = p + (size_t)y * stride; unsigned char *d = o + (size_t)y * w * 4;
        for (int x = 0; x < w; x++, d += 4) {
            switch (fmt) {
            case GL_RGBA: d[0] = s[0]; d[1] = s[1]; d[2] = s[2]; d[3] = s[3]; s += 4; break;
            case GL_BGRA_: d[0] = s[2]; d[1] = s[1]; d[2] = s[0]; d[3] = s[3]; s += 4; break;
            case GL_RGB: d[0] = s[0]; d[1] = s[1]; d[2] = s[2]; d[3] = 255; s += 3; break;
            case GL_BGR_: d[0] = s[2]; d[1] = s[1]; d[2] = s[0]; d[3] = 255; s += 3; break;
            case GL_LUMINANCE_ALPHA: d[0] = d[1] = d[2] = s[0]; d[3] = s[1]; s += 2; break;
            case GL_ALPHA: d[0] = d[1] = d[2] = 255; d[3] = s[0]; s += 1; break;
            default: d[0] = d[1] = d[2] = d[3] = s[0]; s += 1; break;     /* LUMINANCE/INTENSITY/RED */
            }
        }
    }
    return o;
}

static void write_tga(const char *path, const unsigned char *rgba, int w, int h)
{
    HANDLE f = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (f == INVALID_HANDLE_VALUE) return;
    unsigned char hdr[18] = { 0 }; DWORD wr;
    hdr[2] = 2; hdr[12] = w & 255; hdr[13] = w >> 8; hdr[14] = h & 255; hdr[15] = h >> 8;
    hdr[16] = 32; hdr[17] = 0x28;              /* 32 bpp, 8 alpha bits, top-left origin */
    WriteFile(f, hdr, 18, &wr, NULL);
    unsigned char *row = malloc((size_t)w * 4);
    for (int y = 0; y < h && row; y++) {
        const unsigned char *s = rgba + (size_t)y * w * 4;
        for (int x = 0; x < w; x++) { row[x*4] = s[x*4+2]; row[x*4+1] = s[x*4+1]; row[x*4+2] = s[x*4]; row[x*4+3] = s[x*4+3]; }
        WriteFile(f, row, w * 4, &wr, NULL);
    }
    free(row); CloseHandle(f);
}

static void tex_init(void)
{
    char path[MAX_PATH], pat[MAX_PATH]; WIN32_FIND_DATAA fd; HANDLE h;
    GetModuleFileNameA(g_self, g_tex_dir, sizeof g_tex_dir);
    char *p = strrchr(g_tex_dir, '\\'); strcpy(p ? p + 1 : g_tex_dir, "sswrap_textures");
    if (cfg.tex_dump) {
        CreateDirectoryA(g_tex_dir, NULL);
        snprintf(path, sizeof path, "%s\\dump", g_tex_dir); CreateDirectoryA(path, NULL);
        /* remember what is already dumped so restarts don't rewrite */
        snprintf(pat, sizeof pat, "%s\\dump\\*.tga", g_tex_dir);
        if ((h = FindFirstFileA(pat, &fd)) != INVALID_HANDLE_VALUE) {
            do {
                unsigned long long v; int w, hh;
                if (sscanf(fd.cFileName, "%dx%d_%16llx", &w, &hh, &v) == 3) {
                    if (g_ndumped == g_cap_dumped) { g_cap_dumped = g_cap_dumped ? g_cap_dumped * 2 : 1024; g_dumped = realloc(g_dumped, g_cap_dumped * sizeof *g_dumped); }
                    g_dumped[g_ndumped++] = v;
                }
            } while (FindNextFileA(h, &fd));
            FindClose(h);
        }
    }
    if (cfg.tex_replace) {
        snprintf(pat, sizeof pat, "%s\\load\\*", g_tex_dir);
        if ((h = FindFirstFileA(pat, &fd)) != INVALID_HANDLE_VALUE) {
            do {
                if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
                g_load_names = realloc(g_load_names, (g_nload + 1) * sizeof *g_load_names);
                lstrcpynA(g_load_names[g_nload++].name, fd.cFileName, sizeof g_load_names[0].name);
            } while (FindNextFileA(h, &fd));
            FindClose(h);
        }
    }
    lg(1, "textures: dump %s (%d already dumped), %d replacement files in %s\\load",
       cfg.tex_dump ? "ON" : "off", g_ndumped, g_nload, g_tex_dir);
}

static int already_dumped(unsigned long long v)
{
    for (int i = 0; i < g_ndumped; i++) if (g_dumped[i] == v) return 1;
    return 0;
}

static const char *find_replacement(const char *base)
{
    size_t n = strlen(base);
    for (int i = 0; i < g_nload; i++)
        if (!strncmp(g_load_names[i].name, base, n) && g_load_names[i].name[n] == '.') return g_load_names[i].name;
    return NULL;
}

static int is_replaced(GLuint id)
{
    for (int i = 0; i < g_nreplaced; i++) if (g_replaced[i] == id) return 1;
    return 0;
}
static void unmark_replaced(GLuint id)
{
    for (int i = 0; i < g_nreplaced; i++) if (g_replaced[i] == id) { g_replaced[i] = g_replaced[--g_nreplaced]; return; }
}

static GLuint bound_tex(void) { GLint id = 0; REAL(glGetIntegerv)(GL_TEXTURE_BINDING_2D, &id); return (GLuint)id; }

void WINAPI hk_glTexImage2D(GLenum tg, GLint lv, GLint ifmt, GLsizei w, GLsizei h, GLint bd, GLenum fmt, GLenum type, const GLvoid *px)
{
    if (tg != GL_TEXTURE_2D || (!cfg.tex_dump && !g_nload)) { REAL(glTexImage2D)(tg, lv, ifmt, w, h, bd, fmt, type, px); return; }
    GLuint id = bound_tex();
    if (lv > 0) {
        if (is_replaced(id)) return;             /* our replacement has its own generated mipmaps */
        REAL(glTexImage2D)(tg, lv, ifmt, w, h, bd, fmt, type, px); return;
    }
    unmark_replaced(id);
    InterlockedIncrement(&st_uploads);
    int bpp = tex_bpp(fmt, type);
    if (!px || !bpp || w <= 0 || h <= 0 || bd) {
        if (InterlockedIncrement(&st_unsupported) <= 10)
            lg(1, "textures: skipping %dx%d %s type 0x%x%s", w, h, fmt_name(fmt), type, px ? "" : " (no data)");
        REAL(glTexImage2D)(tg, lv, ifmt, w, h, bd, fmt, type, px); return;
    }
    int stride = row_stride(w, bpp);
    unsigned long long v = tex_hash(px, w, h, bpp, stride, fmt);
    char base[48]; snprintf(base, sizeof base, "%dx%d_%016llx", w, h, v);

    const char *rep = g_nload ? find_replacement(base) : NULL;
    if (rep) {
        char path[MAX_PATH]; int rw, rh, n;
        snprintf(path, sizeof path, "%s\\load\\%s", g_tex_dir, rep);
        unsigned char *img = stbi_load(path, &rw, &rh, &n, 4);
        if (img) {
            REAL(glTexParameteri)(tg, GL_GENERATE_MIPMAP_, GL_TRUE);
            REAL(glTexImage2D)(tg, 0, GL_RGBA8_, rw, rh, 0, GL_RGBA, GL_UNSIGNED_BYTE, img);
            stbi_image_free(img);
            if (g_nreplaced < 4096) g_replaced[g_nreplaced++] = id;
            if (InterlockedIncrement(&st_replaced) <= 20) lg(1, "textures: replaced %s with %dx%d %s", base, rw, rh, rep);
            return;
        }
        lg(0, "textures: could not load %s: %s", path, stbi_failure_reason());
    }
    if (cfg.tex_dump && !already_dumped(v)) {
        unsigned char *rgba = to_rgba(px, w, h, stride, fmt);
        if (rgba) {
            char path[MAX_PATH]; snprintf(path, sizeof path, "%s\\dump\\%s.tga", g_tex_dir, base);
            write_tga(path, rgba, w, h); free(rgba);
            if (g_ndumped == g_cap_dumped) { g_cap_dumped = g_cap_dumped ? g_cap_dumped * 2 : 1024; g_dumped = realloc(g_dumped, g_cap_dumped * sizeof *g_dumped); }
            g_dumped[g_ndumped++] = v;
            if (InterlockedIncrement(&st_dumped) % 100 == 1) lg(1, "textures: dumped %ld so far (latest %s %s)", st_dumped, base, fmt_name(fmt));
        }
    }
    REAL(glTexImage2D)(tg, lv, ifmt, w, h, bd, fmt, type, px);
}

void WINAPI hk_glTexSubImage2D(GLenum tg, GLint lv, GLint x, GLint y, GLsizei w, GLsizei h, GLenum fmt, GLenum type, const GLvoid *px)
{
    if (g_nreplaced && tg == GL_TEXTURE_2D && is_replaced(bound_tex())) {
        LG_FIRST(5, 1, "textures: ignoring a %dx%d sub-image update to a replaced texture", w, h);
        return;
    }
    REAL(glTexSubImage2D)(tg, lv, x, y, w, h, fmt, type, px);
}

void WINAPI hk_glDeleteTextures(GLsizei n, const GLuint *ids)
{
    for (int i = 0; i < n && g_nreplaced; i++) unmark_replaced(ids[i]);
    REAL(glDeleteTextures)(n, ids);
}

static void tex_forget(void) { g_nreplaced = 0; }   /* on GL context change */
